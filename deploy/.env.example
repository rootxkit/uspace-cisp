# uspace-cisp environment: every CISP_* variable with its default and one
# line of meaning, grouped by process. Copy to deploy/.env (git-ignored)
# and fill in. An empty value means "use the default". A CISP_* variable
# that is not listed here is refused at start (a typo must not silently
# take a default); internal/config's test keeps this file and the code in
# step. Secrets are redacted in the startup log. No real hostname,
# password or key belongs in this file.

# --- every process ----------------------------------------------------
# Log level: debug, info, warn, error.
CISP_LOG_LEVEL=info
# Seconds between status lines (info when healthy, error when degraded).
CISP_STATUS_INTERVAL_S=30
# Seconds in-flight requests get to finish after SIGTERM.
CISP_SHUTDOWN_TIMEOUT_S=10
# OTLP/HTTP traces endpoint URL; empty = tracing off (no-op provider).
CISP_OTEL_ENDPOINT=

# --- stores and bus (api, deliver, cispctl) ---------------------------
# Relational database (PostgreSQL + PostGIS), postgres:// URL. Secret: the password is redacted.
CISP_DATABASE_URL=
# Timeseries database (TimescaleDB), postgres:// URL. Read-only role for api, read/write for deliver.
CISP_TIMESERIES_URL=
# Largest relational connection pool per process.
CISP_DATABASE_MAX_CONNS=8
# Largest timeseries connection pool per process.
CISP_TIMESERIES_MAX_CONNS=2
# NATS JetStream, nats:// or tls:// URL; empty = not configured (reported, never hidden).
CISP_NATS_URL=
# NATS credentials file path (per-process NATS user); empty = none.
CISP_NATS_CREDS_FILE=

# --- api ----------------------------------------------------------------
# Listen address of the HTTP API (host:port).
CISP_HTTP_ADDR=:8080
# Per-request handler deadline in seconds; past it the answer is 503.
CISP_HANDLER_TIMEOUT_S=10
# Default request body cap in bytes (routes that need more raise it).
CISP_MAX_BODY_BYTES=65536
# Issuer (iss) of ecosystem tokens: the authority's token service URL.
CISP_TOKEN_ISSUER=
# JWKS URL of that issuer.
CISP_TOKEN_JWKS_URL=
# Accepted token audiences: comma-separated hosts (the public host, a lab alias).
CISP_AUDIENCES=
# Client id of the authority, the only publisher of zones, uspace_airspace and ussp_list.
CISP_AUTHORITY_CLIENT_ID=authority-01
# Client id of the ANSP, the only publisher of restrictions.
CISP_ANSP_CLIENT_ID=ansp-01
# JWKS URL of the ANSP's publication signing key.
CISP_ANSP_JWKS_URL=
# Expected mTLS subject of the ANSP's client certificate (forwarded by Caddy).
CISP_ANSP_MTLS_SUBJECT=
# mTLS for the ANSP routes: required or off (off is logged at error level every status period).
CISP_MTLS_MODE=required
# PEM file of the CISP's signing key (outside the repository).
CISP_SIGNING_KEY_FILE=
# Key id (kid) of that signing key.
CISP_SIGNING_KID=
# PEM file of the previous signing key, served in the JWKS during rotation.
CISP_SIGNING_KEY_PREV_FILE=
# PEM file of the console session signing key.
CISP_SESSION_KEY_FILE=
# Key encrypting stored secrets (console TOTP). Secret: always redacted.
CISP_SECRETS_KEY=
# Public base URL of this CISP (the only place its hostname lives).
CISP_PUBLIC_BASE_URL=
# Issuer URL the CISP puts in what it signs.
CISP_ISSUER_URL=
# Cache-Control max-age of dataset reads, seconds.
CISP_READ_MAX_AGE_S=60
# Public read rate limit, requests per minute per client.
CISP_PUBLIC_RPM=60
# Largest accepted publication body, bytes (32 MiB).
CISP_MAX_PUBLICATION_BYTES=33554432
# Most subscriptions one client may hold.
CISP_MAX_SUBSCRIPTIONS_PER_CLIENT=20
# Branding bundle file (console name, logo path, contact).
CISP_BRANDING_FILE=

# --- deliver --------------------------------------------------------------
# Internal listen address of deliver (/healthz, /metrics).
CISP_DELIVER_HTTP_ADDR=:8081
# Days the delivery log (delivery_attempts) is kept.
CISP_DELIVERY_LOG_RETENTION_DAYS=90
# Allow webhook callbacks to private addresses (lab only).
CISP_ALLOW_PRIVATE_CALLBACKS=false
# Allow http:// webhook callbacks (lab only).
CISP_ALLOW_INSECURE_CALLBACKS=false

# --- web (WP-9) -------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=

# --- compose only (deploy/compose.yml), not read by the Go processes ----
# Superuser password of the postgres container.
POSTGRES_PASSWORD=
# Login passwords of the two application roles deploy/postgres/init.sql
# creates (cisp_api, cisp_deliver); the CISP_*_URL values above use them.
PG_CISP_API_PASSWORD=
PG_CISP_DELIVER_PASSWORD=
