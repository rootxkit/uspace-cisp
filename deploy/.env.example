# uspace-cisp environment: every CISP_* variable with its default and one
# line of meaning, grouped by process. Copy to deploy/.env (git-ignored)
# and fill in. An empty value means "use the default". A CISP_* variable
# that is not listed here is refused at start (a typo must not silently
# take a default); internal/config's test keeps this file and the code in
# step. Secrets are redacted in the startup log. No real hostname,
# password or key belongs in this file.

# --- every process ----------------------------------------------------
# Log level: debug, info, warn, error.
CISP_LOG_LEVEL=info
# Seconds between status lines (info when healthy, error when degraded).
CISP_STATUS_INTERVAL_S=30
# Seconds in-flight requests get to finish after SIGTERM.
CISP_SHUTDOWN_TIMEOUT_S=10
# OTLP/HTTP traces endpoint URL; empty = tracing off (no-op provider).
CISP_OTEL_ENDPOINT=

# --- stores and bus (api, deliver, cispctl) ---------------------------
# Relational database (PostgreSQL + PostGIS), postgres:// URL. Secret: the password is redacted.
CISP_DATABASE_URL=
# Timeseries database (TimescaleDB), postgres:// URL. Read-only role for api, read/write for deliver.
CISP_TIMESERIES_URL=
# Largest relational connection pool per process.
CISP_DATABASE_MAX_CONNS=8
# Largest timeseries connection pool per process.
CISP_TIMESERIES_MAX_CONNS=2
# NATS JetStream, nats:// or tls:// URL; empty = not configured (reported, never hidden).
CISP_NATS_URL=
# NATS credentials file path (per-process NATS user); empty = none.
CISP_NATS_CREDS_FILE=
# Seconds a process waits for the broker at start before it starts
# degraded ("nats: never connected") and keeps reconnecting in the
# background; 0 = do not wait.
CISP_NATS_CONNECT_TIMEOUT_S=5

# --- api ----------------------------------------------------------------
# Listen address of the HTTP API (host:port).
CISP_HTTP_ADDR=:8080
# Per-request handler deadline in seconds; past it the answer is 503.
CISP_HANDLER_TIMEOUT_S=10
# Default request body cap in bytes (routes that need more raise it).
CISP_MAX_BODY_BYTES=65536
# Slowest request body upload accepted, in bytes per second: a body has
# its route cap divided by this rate (at least CISP_HANDLER_TIMEOUT_S) to
# arrive; the handler deadline starts once it has (408 otherwise).
CISP_BODY_READ_MIN_BYTES_PER_S=65536
# Issuer (iss) of ecosystem tokens: the authority's token service URL. Required.
CISP_TOKEN_ISSUER=
# JWKS URL of that issuer (https; http only for localhost). Required. It also
# holds the authority's publication signing key (distinguished by kid).
CISP_TOKEN_JWKS_URL=
# Optional second token issuer: the lab's token issuer (lab WP-L2).
CISP_LAB_ISSUER=
# JWKS URL of the lab issuer (https; http only for localhost); set with CISP_LAB_ISSUER.
CISP_LAB_JWKS_URL=
# File the last good JWKS of every issuer is written to; used at start when an issuer is unreachable.
CISP_JWKS_CACHE_FILE=local/jwks-cache.json
# Accepted token audiences: comma-separated hosts (the public host, a lab alias). Required, no default.
CISP_AUDIENCES=
# Client id of the authority, the only publisher of zones, uspace_airspace and ussp_list.
CISP_AUTHORITY_CLIENT_ID=authority-01
# Client id of the ANSP, the only publisher of restrictions.
CISP_ANSP_CLIENT_ID=ansp-01
# JWKS URL of the ANSP's publication signing key (https; http only for localhost).
CISP_ANSP_JWKS_URL=
# Expected mTLS subject of the ANSP's client certificate (forwarded by Caddy). Required when CISP_MTLS_MODE=required.
CISP_ANSP_MTLS_SUBJECT=
# mTLS for the ANSP routes: required or off (off is logged at error level every status period).
CISP_MTLS_MODE=required
# PEM file of the CISP's signing key, RSA >= 3072 bits (outside the repository; cispctl rotate-key).
CISP_SIGNING_KEY_FILE=
# Key id (kid) of that signing key.
CISP_SIGNING_KID=
# PEM file of the previous signing key, served in the JWKS during rotation.
CISP_SIGNING_KEY_PREV_FILE=
# Key id (kid) of the previous signing key; set with CISP_SIGNING_KEY_PREV_FILE.
CISP_SIGNING_KID_PREV=
# How far a publisher's detached signature iat may be from now, seconds (5 min).
CISP_PUBLISHER_SIGNATURE_MAX_SKEW_S=300
# PEM file of the console session signing key (RSA, at least 3072 bits;
# its kid is derived from the key). Required with CISP_DATABASE_URL.
CISP_SESSION_KEY_FILE=
# Key encrypting stored secrets (console TOTP): 32 bytes, standard base64
# (openssl rand -base64 32). Required with CISP_DATABASE_URL. Secret:
# always redacted.
CISP_SECRETS_KEY=
# iss of console session tokens (a URL of this CISP's own, distinct from
# CISP_TOKEN_ISSUER). Required with CISP_DATABASE_URL.
CISP_CONSOLE_ISSUER=
# Public base URL of this CISP (the only place its hostname lives).
CISP_PUBLIC_BASE_URL=
# Issuer URL the CISP puts in what it signs (the iss of every webhook).
# deliver needs it, CISP_PUBLIC_BASE_URL and the signing key whenever
# CISP_DATABASE_URL is set.
CISP_ISSUER_URL=
# Cache-Control max-age of dataset reads, seconds.
CISP_READ_MAX_AGE_S=60
# Public read rate limit, requests per minute per client.
CISP_PUBLIC_RPM=60
# Proxies (CIDRs, comma-separated) whose X-Forwarded-For names the client
# of a public read: the Caddy address. Empty: the peer address is the
# client, and a forwarded header is never believed.
CISP_TRUSTED_PROXY_CIDR=
# Largest accepted publication body, bytes (32 MiB).
CISP_MAX_PUBLICATION_BYTES=33554432
# Most subscriptions one client may hold.
CISP_MAX_SUBSCRIPTIONS_PER_CLIENT=20
# Branding bundle file (console name, logo path, contact).
CISP_BRANDING_FILE=
# Largest accepted restriction body (POST and PATCH /v1/restrictions),
# bytes (256 KiB).
CISP_MAX_RESTRICTION_BYTES=262144
# The restriction expiry's tick, seconds: an active restriction past its
# ends_at is ended (ended_by expiry) within one tick.
CISP_RESTRICTION_EXPIRY_INTERVAL_S=5
# How old the expiry's last run may be before the status line errs (a
# dead ticker is never silent), seconds; above the interval.
CISP_RESTRICTION_EXPIRY_STALE_AFTER_S=30
# WS /v1/stream: clients per api instance (the next upgrade is 503).
CISP_STREAM_MAX_CLIENTS=1000
# Frames queued per stream client; a client whose queue is full is
# closed with 1013 and counted (stream_clients_dropped).
CISP_STREAM_SEND_BUFFER_FRAMES=64
# Period of the console/status/v1 frame, seconds.
CISP_STREAM_STATUS_INTERVAL_S=2
# Deadline of one frame's write to a stream client, seconds.
CISP_STREAM_WRITE_TIMEOUT_S=5
# live_max_age_s told to stream clients: a stream silent for longer is
# not live (at least the status interval), seconds.
CISP_STREAM_LIVE_MAX_AGE_S=6
# Origins a browser may upgrade WS /v1/stream from, beside the origin of
# CISP_PUBLIC_BASE_URL; comma-separated scheme://host[:port].
CISP_STREAM_ALLOWED_ORIGINS=
# true: the stream is public and a uspace_session cookie is optional;
# false: a valid console session cookie is required (else close 4401).
CISP_STREAM_PUBLIC=true

# --- deliver --------------------------------------------------------------
# Internal listen address of deliver (/healthz, /metrics).
CISP_DELIVER_HTTP_ADDR=:8081
# Days the delivery log (delivery_attempts) is kept.
CISP_DELIVERY_LOG_RETENTION_DAYS=90
# Allow webhook callbacks that are literal IPs, localhost, .local,
# .internal or .localhost names, or resolve to loopback, private,
# link-local or CGNAT addresses (lab only). Read by api (registration)
# and deliver (every dial).
CISP_ALLOW_PRIVATE_CALLBACKS=false
# Allow http:// webhook callbacks to localhost (lab only). api and deliver.
CISP_ALLOW_INSECURE_CALLBACKS=false

# --- web (WP-9) -------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=

# --- compose only (deploy/compose.yml), not read by the Go processes ----
# Superuser password of the postgres container.
POSTGRES_PASSWORD=
# Login passwords of the two application roles deploy/postgres/init.sql
# creates (cisp_api, cisp_deliver); the CISP_*_URL values above use them.
PG_CISP_API_PASSWORD=
PG_CISP_DELIVER_PASSWORD=
